{
  "name": "errling",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "npm run build:wallet && concurrently -k -n api,web,example -c cyan,green,yellow \"tsx watch apps/api/src/server.ts\" \"vite --config apps/web/vite.config.ts\" \"vite --config apps/reference-dapp/vite.config.ts\"",
    "build:wallet": "esbuild packages/wallet-runtime/src/index.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=packages/wallet-runtime/dist/wallet.js",
    "build": "npm run build:wallet && vite build --config apps/web/vite.config.ts && vite build --config apps/reference-dapp/vite.config.ts",
    "test": "vitest run",
    "audit:e2e": "node tests/e2e-audit.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proof": "tsx packages/solana-engine/src/proof.ts",
    "cleanup": "node scripts/cleanup-history.mjs"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "concurrently": "9.2.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.0",
    "@wallet-standard/wallet": "1.1.0",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "lucide-react": "0.548.0",
    "playwright": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tweetnacl": "1.0.3",
    "zod": "4.1.12"
  }
}
